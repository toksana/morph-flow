# Copy to .env.local and fill in what you need: cp .env.example .env.local
# On a linked Vercel project, `vercel env pull .env.local` fills these in instead.

# --- Model (required) -------------------------------------------------------
# Vercel AI Gateway key. Not needed when `vercel env pull` writes VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=

# --- Auth: Clerk (optional in `pnpm dev`) -----------------------------------
# Leave empty in `pnpm dev` and Clerk runs in keyless mode with a temporary dev instance.
# Required for `pnpm build` / `pnpm start` and `pnpm test:e2e`; development keys are fine.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database: Neon Postgres (to save signed-in users) ---------------------
# Guests never touch the database. Signed-in users are saved on each generation; without
# it the save fails and is logged, but the card still streams. `pnpm db:migrate` needs it.
DATABASE_URL=

# --- Rate limit: Upstash Redis (optional) -----------------------------------
# Without both, the hourly generation limit is off and the server logs a warning.
# The Upstash for Redis integration on Vercel sets these names.
KV_REST_API_URL=
KV_REST_API_TOKEN=
